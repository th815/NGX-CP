# Binaries
/bin/
*.exe

# Local DB / runtime
dev.db
dev.db-*
*.db-shm
*.db-wal

# Secrets / PKI
/etc/ngxcp/
*.key
*.crt
master.key

# Editor / OS
.idea/
.vscode/
.DS_Store

# Build / deps caches
/vendor/

# Local agent memory / project data (must NOT be public)
.workbuddy/

# Real config & env (keep only config.example.yaml)
configs/config.yaml
configs/*.local.yaml
.env
.env.*
*.local.yaml

# Agent 一次性接入令牌（deploy-agent.sh 的 NGXCP_AGENT_TOKENS_FILE，含机密）
.agent-tokens
*.tokens

# Certificates / PKI material
*.pem
*.p12
*.pfx

# Logs & test artifacts
*.log
coverage.out
*.out

# Misc DB / sqlite
*.sqlite
*.sqlite3

# Node deps (if any tooling added)
node_modules/

# Frontend build output
web/dist/

# 节点自注册分发的预编译 Agent 二进制（make dist 生成，勿入版本库）
dist/
